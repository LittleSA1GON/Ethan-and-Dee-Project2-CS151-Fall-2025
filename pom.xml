<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- project info -->
  <groupId>com.ethananddee-cs151-fall2025-game</groupId>
  <artifactId>gameproject</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>   <!-- For Ethan, match Java version, 24 works too with 21 I guess-->
    <maven.compiler.target>21</maven.compiler.target>
    <javafx.version>25</javafx.version>                 <!-- For Ethan, match your JavaFx version -->
    <javafx.platform></javafx.platform>
    <mainClass>game.gamemanager.GameManager</mainClass> <!-- default-->
  </properties>

  <!-- JavaFX dependencies -->
  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>

    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier> <!-- will be set by OS profiles below -->
    </dependency>
  </dependencies>

  <!-- Build settings -->
  <build>
    <plugins>
      <!-- JavaFX Maven plugin -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <!-- For Ethan, we will keep this but test run our games telling Maven which main class to run -->
          <mainClass>${mainClass}</mainClass> <!-- default-->
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
  <!-- macOS Apple Silicon -->
    <profile>
      <id>mac-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
    </profile>

    <!-- Windows x64 -->
    <profile>
      <id>windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties><javafx.platform>win</javafx.platform></properties>
    </profile>

    <!-- (Optional) Intel Mac fallback -->
    <profile>
      <id>mac-intel</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><javafx.platform>mac</javafx.platform></properties>
    </profile>

  </profiles>

</project>
